# ============================================================
# proyecto_83 — Configuración del entorno
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el archivo .env al repositorio.
# ============================================================

# ------------------------------------------------------------
# Ollama
# ------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# ------------------------------------------------------------
# PostgreSQL (base de datos de portabilidad)
# ------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=portabilidad
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Opcional: si la BD usa un esquema específico de PostgreSQL
# POSTGRES_SCHEMA=public

# ------------------------------------------------------------
# Rutas (dejar vacío para usar rutas por defecto relativas al proyecto)
# En Windows usa barras diagonales normales (/), no invertidas (\)
# Ejemplo Windows: C:/Users/tu_usuario/proyecto_83/data/chroma_db
# ------------------------------------------------------------
CHROMA_BASE_DIR=
DATA_DOCS_DIR=
OUTPUT_DIR=

# ------------------------------------------------------------
# Parámetros de RAG
# ------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ------------------------------------------------------------
# Parámetros del juez LLM-as-a-judge
# Puntaje mínimo (sobre 10) para considerar el informe aprobado
# ------------------------------------------------------------
JUDGE_MIN_SCORE=7
