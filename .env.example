# ─── Proveedor LLM ────────────────────────────────────────────────────────────
# Opciones: "groq" (recomendado) | "huggingface"
LLM_PROVIDER=groq

# ─── Groq (recomendado: gratis, rápido, sin tarjeta de crédito) ───────────────
# Obtén tu key en: https://console.groq.com → API Keys → Create API Key
GROQ_API_KEY=gsk_tu_api_key_aqui

# Modelo Groq
GROQ_MODEL=llama-3.1-8b-instant

# ─── HuggingFace (alternativa gratuita) ───────────────────────────────────────
# Obtén tu token en: https://huggingface.co → Settings → Access Tokens → New token (rol: Read)
HF_TOKEN=hf_tu_token_aqui

# Modelo HuggingFace
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# ─── Base de datos ────────────────────────────────────────────────────────────
SQLITE_DB_PATH=data/portabilidad.db

# ─── Salida ───────────────────────────────────────────────────────────────────
OUTPUT_DIR=output

# ─── LLM Judge ────────────────────────────────────────────────────────────────
JUDGE_MIN_SCORE=7

# ─── Plantilla Word (opcional) ────────────────────────────────────────────────
# Ruta a un .docx con estilos/logo corporativo. Deja vacío para usar formato por defecto.
WORD_TEMPLATE=
